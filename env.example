# ============================================
# Curso AI Engineer — Variables de entorno
# Copiá este archivo a .env y completá los valores.
#   cp env.example .env
# ============================================

# --- LLM proveedores ---

# Anthropic (proveedor principal del curso)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (comparativas y alternativas a partir del Módulo 1)
OPENAI_API_KEY=sk-...

# Ollama (modelos open-source locales — solo si levantás el profile "local-llm")
OLLAMA_BASE_URL=http://localhost:11434

# --- BBDD ---

# PostgreSQL + pgvector
POSTGRES_USER=curso
POSTGRES_PASSWORD=curso
POSTGRES_DB=curso_ai
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://curso:curso@localhost:5432/curso_ai

# Qdrant (comparativa, opcional)
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- Observabilidad ---

# Langfuse (a partir del Módulo 6, opcional antes)
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=cambiar-en-produccion
LANGFUSE_SALT=cambiar-en-produccion
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# --- Configuración general ---

# Modelo por defecto para los ejercicios (cambiar según el caso)
DEFAULT_MODEL=claude-sonnet-4-6

# Presupuesto sugerido por sesión (USD) — informativo
SESSION_BUDGET_USD=1.00
