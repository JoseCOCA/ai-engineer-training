# ============================================================
# Curso AI Engineer — Plantilla de variables de entorno
# ============================================================
#
# CÓMO USAR ESTE ARCHIVO:
#
# 1. Copia este archivo a .env (sin la palabra "example"):
#       cp env.example .env
#
# 2. Configura AL MENOS UNO de los proveedores LLM. El curso es
#    proveedor-agnóstico — el smoke test y todos los ejercicios
#    funcionan con cualquiera de los soportados.
#
# 3. NO subas el .env real a git. El .gitignore lo excluye.
#
# FORMATO DE VARIABLES:
#   - Sin comillas alrededor de los valores: KEY=valor
#   - Sin espacios alrededor del =:           KEY=valor   (correcto)
#                                             KEY = valor (incorrecto)
#   - Sin punto y coma al final
#   - Para valores con espacios o caracteres especiales,
#     usa comillas dobles: KEY="mi valor con espacios"
#   - Líneas que empiezan con # son comentarios
#
# ============================================================


# =============================================================
# PROVEEDORES LLM — configura al menos uno
# =============================================================

# --- Ollama (local, gratis, sin límites) ---
# Recomendado si tu hardware lo soporta. Ver docs/01-setup.md sección 5.2
# para instalación. Si Ollama no está instalado, comenta o elimina esta variable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Google Gemini (cloud, free tier amplio: 1500 req/día) ---
# Recomendado como motor cloud principal del curso.
# Conseguir en: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Anthropic Claude (cloud, opcional — solo para sesiones de comparativa) ---
# Conseguir en: https://console.anthropic.com/settings/keys
# Anthropic suele dar créditos gratuitos al registro.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (cloud, opcional — solo para sesiones de comparativa) ---
# Conseguir en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# =============================================================
# CONFIGURACIÓN GENERAL DEL CURSO
# =============================================================

# Proveedor por defecto cuando un ejercicio no especifica otro.
# Valores válidos: "ollama" | "google" | "anthropic" | "openai"
DEFAULT_LLM_PROVIDER=ollama

# Presupuesto sugerido por sesión (USD) — informativo
SESSION_BUDGET_USD=0.50


# =============================================================
# BASES DE DATOS
# =============================================================

# PostgreSQL + pgvector (BBDD vectorial principal del curso, desde Módulo 3)
POSTGRES_USER=curso
POSTGRES_PASSWORD=curso
POSTGRES_DB=curso_ai
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://curso:curso@localhost:5432/curso_ai

# Qdrant (BBDD vectorial alternativa para comparar en el Módulo 3)
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333


# =============================================================
# OBSERVABILIDAD (opcional, a partir del Módulo 6)
# =============================================================

# Langfuse (observabilidad LLM open-source)
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=cambiar-en-produccion
LANGFUSE_SALT=cambiar-en-produccion
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
