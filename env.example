# ============================================================
# Curso AI Engineer — Plantilla de variables de entorno
# ============================================================
#
# CÓMO USAR ESTE ARCHIVO:
#
# 1. Copia este archivo a .env (sin la palabra "example"):
#       cp env.example .env
#
# 2. Reemplaza cada valor de ejemplo con el real de tu cuenta
#    o entorno. NO subas el .env real a git (.gitignore lo
#    excluye automáticamente).
#
# FORMATO DE VARIABLES:
#   - Sin comillas alrededor de los valores: KEY=valor
#   - Sin espacios alrededor del =:           KEY=valor   (correcto)
#                                             KEY = valor (incorrecto)
#   - Sin punto y coma al final
#   - Para valores con espacios o caracteres especiales,
#     usa comillas dobles: KEY="mi valor con espacios"
#   - Líneas que empiezan con # son comentarios
#
# CONVENCIONES DEL CURSO:
#   - Los valores con "..." son placeholders — reemplazarlos.
#   - Las variables con valor por defecto seguro pueden dejarse
#     como están si solo trabajas en local.
#   - En producción, cambia TODO lo marcado como "cambiar-en-produccion".
#
# ============================================================


# --- LLM proveedores ---

# Anthropic (proveedor principal del curso)
# Conseguir en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (comparativas y alternativas a partir del Módulo 1)
# Conseguir en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Ollama (modelos open-source locales — solo si levantas el profile "local-llm")
OLLAMA_BASE_URL=http://localhost:11434


# --- Bases de datos ---

# PostgreSQL + pgvector (BBDD vectorial principal)
POSTGRES_USER=curso
POSTGRES_PASSWORD=curso
POSTGRES_DB=curso_ai
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://curso:curso@localhost:5432/curso_ai

# Qdrant (BBDD vectorial alternativa para comparar en el Módulo 3)
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333


# --- Observabilidad ---

# Langfuse (observabilidad LLM, a partir del Módulo 6 — opcional antes)
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=cambiar-en-produccion
LANGFUSE_SALT=cambiar-en-produccion
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000


# --- Configuración general ---

# Modelo por defecto para los ejercicios (cambiar según el caso)
DEFAULT_MODEL=claude-sonnet-4-6

# Presupuesto sugerido por sesión (USD) — informativo
SESSION_BUDGET_USD=1.00
